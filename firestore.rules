rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function clientId() { return request.auth.token.clientId; }
    function ownerOrAdvisor() { return signedIn() && (role() in ['Owner', 'Advisor']); }
    function canReadClient(id) { return ownerOrAdvisor() || (signedIn() && clientId() == id); }

    match /clients/{id} {
      allow read: if canReadClient(id);
      allow write: if ownerOrAdvisor();
    }
    match /artworks/{id} {
      allow read: if canReadClient(resource.data.clientId);
      allow create, update, delete: if ownerOrAdvisor();
    }
    match /documents/{id} {
      allow read: if canReadClient(resource.data.clientId);
      allow create: if ownerOrAdvisor();
      allow update, delete: if ownerOrAdvisor();
    }
    match /messages/{id} {
      allow read: if canReadClient(resource.data.clientId);
      allow create: if signedIn() && canReadClient(request.resource.data.clientId);
      allow update, delete: if false;
    }
    match /auditEvents/{id} {
      allow read: if ownerOrAdvisor();
      allow create: if signedIn();
      allow update, delete: if false;
    }
    match /marketUpdates/{id} {
      allow read: if signedIn();
      allow write: if ownerOrAdvisor();
    }
  }
}
